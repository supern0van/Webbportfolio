---
import HantverkareLayout from "../../layouts/HantverkareLayout.astro";
import Placeholder from "../../components/Placeholder.astro";

const services = ["Badrumsrenovering", "Tillbyggnad", "Kök", "Fasad & tak"];
---

<HantverkareLayout
  title="Byggfirma i Storgöteborg"
  description="Ek & Sten Bygg gör renoveringar, tillbyggnader och nybyggen i Storgöteborg."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Ek & Sten Bygg</p>
      <h1 style="font-size: clamp(2.2rem, 5vw, 3.4rem); max-width: 36rem; text-transform: uppercase;">
        Byggt för att hålla.
      </h1>
      <p class="lede" style="margin-top: 1.1rem;">
        Vi tar hand om hela projektet — från första besiktning till städat
        golv. Fasta priser, tydliga tidsplaner och ett telefonnummer som
        alltid svarar.
      </p>
      <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
        <a class="btn btn-primary" href="/hantverkare/offert/">Få offert</a>
        <a class="btn btn-secondary" href="/hantverkare/referensjobb/">Se referensjobb</a>
      </div>
    </div>
  </section>

  <section class="section section--tight" style="border-top: 1px solid var(--border);">
    <div class="container">
      <p class="eyebrow">Vi jobbar med</p>
      <div class="grid grid-4" style="margin-top: 1.5rem;">
        {
          services.map((service) => (
            <div class="card" style="text-align: center;">
              <h2 style="font-size: 1rem;">{service}</h2>
            </div>
          ))
        }
      </div>
      <p style="margin-top: 1.75rem;">
        <a class="btn btn-secondary" href="/hantverkare/tjanster/">Se alla tjänster →</a>
      </p>
    </div>
  </section>

  <section class="section" style="border-top: 1px solid var(--border);">
    <div class="container grid grid-2" style="align-items: center;">
      <Placeholder label="Pågående jobb" ratio="4 / 3" variant="primary" />
      <div>
        <p class="eyebrow">Trygghet</p>
        <h2 style="font-size: clamp(1.6rem, 3vw, 2.1rem);">Försäkrat, licensierat, på riktigt</h2>
        <p style="margin-top: 1rem; color: var(--fg-muted);">
          F-skattsedel, ansvarsförsäkring och egna hantverkare — vi hyr inte
          in okänd arbetskraft för att pressa priset.
        </p>
      </div>
    </div>
  </section>
</HantverkareLayout>
