---
import HantverkareLayout from "../../../layouts/HantverkareLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Placeholder from "../../../components/Placeholder.astro";

const jobs = [
  { title: "Badrum, Örgryte", text: "Totalrenovering av 6 kvm badrum, 5 veckor." },
  { title: "Tillbyggnad, Askim", text: "22 kvm nytt vardagsrum med stora glaspartier." },
  { title: "Kök, Majorna", text: "Ny köksstomme och omdragen el/vvs, 3 veckor." },
  { title: "Fasad, Partille", text: "Fasadbyte och tilläggsisolering på 1970-talsvilla." },
  { title: "Uterum, Torslanda", text: "Isolerat uterum, 14 kvm, färdigt inför hösten." },
  { title: "Snickeri, Linnéstaden", text: "Skräddarsydda garderober i tre sovrum." },
];
---

<HantverkareLayout title="Referensjobb" description="Ett urval av jobb Ek & Sten Bygg genomfört.">
  <PageHero
    eyebrow="Referensjobb"
    title="Ett urval av vad vi byggt"
    intro="Bilder från riktiga projekt (här ersatta av platshållare i portföljen) — hör gärna av er om ni vill se fler exempel inom just er typ av projekt."
  />

  <section class="section section--tight">
    <div class="container grid grid-3">
      {
        jobs.map((job) => (
          <div class="card">
            <Placeholder label={job.title} ratio="4 / 3" variant="accent" />
            <h2 style="margin-top: 1rem; font-size: 1rem;">{job.title}</h2>
            <p style="margin-top: 0.4rem; color: var(--fg-muted); font-size: 0.9rem;">{job.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</HantverkareLayout>
