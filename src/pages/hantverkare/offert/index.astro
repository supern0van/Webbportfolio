---
import HantverkareLayout from "../../../layouts/HantverkareLayout.astro";
import PageHero from "../../../components/PageHero.astro";
---

<HantverkareLayout title="Få offert" description="Beskriv ert projekt och få en offert från Ek & Sten Bygg.">
  <PageHero
    eyebrow="Få offert"
    title="Beskriv projektet"
    intro="Ju mer ni beskriver, desto mer träffsäker blir den första offerten. Vi återkommer inom två arbetsdagar."
    compact
  />

  <section class="section section--tight">
    <div class="container" style="max-width: 36rem;">
      <div class="card">
        <form class="contact-form" data-demo-form novalidate>
          <div class="field">
            <label for="typ">Typ av projekt</label>
            <select id="typ" name="typ" required>
              <option value="">Välj typ</option>
              <option>Badrumsrenovering</option>
              <option>Tillbyggnad</option>
              <option>Kök</option>
              <option>Fasad & tak</option>
              <option>Annat</option>
            </select>
          </div>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="yta">Ungefärlig yta (kvm)</label>
              <input id="yta" name="yta" type="number" min="1" />
            </div>
            <div class="field">
              <label for="tidsram">Önskad start</label>
              <input id="tidsram" name="tidsram" type="month" />
            </div>
          </div>
          <div class="field">
            <label for="beskrivning">Beskrivning</label>
            <textarea id="beskrivning" name="beskrivning" rows="4" required></textarea>
          </div>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="namn">Namn</label>
              <input id="namn" name="namn" type="text" required />
            </div>
            <div class="field">
              <label for="telefon">Telefon</label>
              <input id="telefon" name="telefon" type="tel" required />
            </div>
          </div>
          <button class="btn btn-primary" type="submit">Skicka förfrågan</button>
          <p class="form-note">Demoformulär — inget skickas, det visar bara flödet.</p>
          <p class="form-success" data-form-success hidden role="status">
            Tack! Vi återkommer med en offert inom två arbetsdagar.
          </p>
        </form>
      </div>
    </div>
  </section>
</HantverkareLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-demo-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const success = form.querySelector<HTMLElement>("[data-form-success]");
    if (success) success.hidden = false;
    form.reset();
  });
</script>
