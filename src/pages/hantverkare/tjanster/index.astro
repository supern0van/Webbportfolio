---
import HantverkareLayout from "../../../layouts/HantverkareLayout.astro";
import PageHero from "../../../components/PageHero.astro";

const services = [
  { name: "Badrumsrenovering", text: "Från riven stomme till klart våtrum, inklusive våtrumsintyg." },
  { name: "Tillbyggnad", text: "Uterum, extra rum eller helt nytt plan — vi sköter bygglovet med er." },
  { name: "Kök", text: "Nya stommar, el och vvs-dragning i samarbete med certifierade underleverantörer." },
  { name: "Fasad & tak", text: "Fasadbyte, takomläggning och tilläggsisolering." },
  { name: "Altaner & uterum", text: "Ritning, markarbete och montage — anpassat efter tomtens läge." },
  { name: "Mindre snickerier", text: "Garderober, innerväggar och andra jobb som inte kräver en stor entreprenad." },
];
---

<HantverkareLayout title="Tjänster" description="Allt Ek & Sten Bygg hjälper till med.">
  <PageHero
    eyebrow="Tjänster"
    title="Från badrum till tillbyggnad"
    intro="Oavsett storlek på jobbet får ni samma sak: en tydlig offert innan vi börjar, och samma team hela vägen till besiktning."
  />

  <section class="section section--tight">
    <div class="container grid grid-3">
      {
        services.map((service) => (
          <div class="card">
            <h2 style="font-size: 1.05rem;">{service.name}</h2>
            <p style="margin-top: 0.6rem; color: var(--fg-muted);">{service.text}</p>
          </div>
        ))
      }
    </div>
    <p style="margin-top: 2rem;">
      <a class="btn btn-primary" href="/hantverkare/offert/">Beskriv ert projekt</a>
    </p>
  </section>
</HantverkareLayout>
