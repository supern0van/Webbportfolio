---
import FrisorLayout from "../../../layouts/FrisorLayout.astro";
import PageHero from "../../../components/PageHero.astro";

const groups = [
  {
    name: "Klippning",
    items: [
      { name: "Dam, klippning & styling", price: "595 kr" },
      { name: "Herr, klippning", price: "395 kr" },
      { name: "Barn t.o.m. 12 år", price: "295 kr" },
    ],
  },
  {
    name: "Färg",
    items: [
      { name: "Helfärgning", price: "895 kr" },
      { name: "Slingor, kort hår", price: "995 kr" },
      { name: "Slingor, långt hår", price: "1295 kr" },
    ],
  },
  {
    name: "Styling",
    items: [
      { name: "Föning", price: "395 kr" },
      { name: "Uppsättning", price: "695 kr" },
    ],
  },
];
---

<FrisorLayout title="Tjänster & priser" description="Prislista för Studio Rae.">
  <PageHero eyebrow="Tjänster & priser" title="Prislista" intro="Priser inkluderar konsultation. Fråga oss gärna om ni är osäkra på vad ni vill ha." />

  <section class="section section--tight">
    <div class="container" style="display: grid; gap: 2.5rem; max-width: 40rem;">
      {
        groups.map((group) => (
          <div>
            <h2 style="font-size: 1.15rem; font-style: italic;">{group.name}</h2>
            <ul style="margin-top: 1rem; display: grid; gap: 0.8rem;">
              {group.items.map((item) => (
                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 0.6rem;">
                  <span>{item.name}</span>
                  <span style="color: var(--fg-muted);">{item.price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p style="margin-top: 2rem;">
      <a class="btn btn-primary" href="/frisor/boka-tid/">Boka tid</a>
    </p>
  </section>
</FrisorLayout>
