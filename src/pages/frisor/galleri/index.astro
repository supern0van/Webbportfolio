---
import FrisorLayout from "../../../layouts/FrisorLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Placeholder from "../../../components/Placeholder.astro";

const images = [
  "Klippning, kort",
  "Balayage",
  "Uppsättning",
  "Klippning, långt",
  "Herrklippning",
  "Färg, helton",
  "Styling, event",
  "Klippning, lugg",
  "Färg, slingor",
];
---

<FrisorLayout title="Galleri" description="Bilder från Studio Rae.">
  <PageHero eyebrow="Galleri" title="Ett urval av vårt arbete" intro="Bilder ersätts här av platshållare i portföljen." />

  <section class="section section--tight">
    <div class="container grid grid-3">
      {images.map((label) => <Placeholder label={label} ratio="4 / 5" variant="accent" />)}
    </div>
  </section>
</FrisorLayout>
