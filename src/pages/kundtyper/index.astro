---
import HubLayout from "../../layouts/HubLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Placeholder from "../../components/Placeholder.astro";

const cases = [
  {
    name: "Ek & Sten Bygg",
    industry: "Hantverkare & bygg",
    tier: "Standard",
    href: "/hantverkare/",
    text: "Tjänstelista, referensgalleri och ett offertformulär som gör det enkelt att komma igång med ett nytt jobb.",
  },
  {
    name: "Restaurang Björk",
    industry: "Restaurang & café",
    tier: "Standard",
    href: "/restaurang/",
    text: "Meny, stämning och ett bokningsformulär för bord — byggt för att kännas varmt redan innan gästen kommer in.",
  },
  {
    name: "Lindqvist & Partners",
    industry: "Advokatbyrå",
    tier: "Standard",
    href: "/advokatbyra/",
    text: "En formell, förtroendeingivande sajt som gör det enkelt att hitta rätt kompetensområde och ta kontakt.",
  },
  {
    name: "Studio Rae",
    industry: "Frisör & skönhet",
    tier: "Premium",
    href: "/frisor/",
    text: "Prislista, galleri och ett bokningsflöde med tidsval direkt i webbläsaren.",
  },
  {
    name: "IFK Lindholmen",
    industry: "Sportförening",
    tier: "Premium",
    href: "/sportforening/",
    text: "Lagöversikt och ett filtrerbart träningsschema, plus ett enkelt sätt att bli medlem.",
  },
  {
    name: "Klarblick Städ",
    industry: "Städfirma",
    tier: "Premium",
    href: "/stadfirma/",
    text: "Tjänstelista och en offertkalkylator som ger ett ungefärligt pris direkt utifrån yta och frekvens.",
  },
  {
    name: "Elin Karlsson",
    industry: "Enskild företagare, massageterapeut",
    tier: "Bas",
    href: "/enkel-foretagare/",
    text: "En enda sida som täcker allt en besökare behöver: vad, för vem, och hur man bokar tid.",
  },
];
---

<HubLayout
  title="Kundtyper"
  description="Sju fiktiva exempelsajter som visar vilken typ av hemsidor Nova IT kan bygga — från enkla enskilda sidor till interaktiva bokningsflöden."
>
  <PageHero
    eyebrow="Kundtyper"
    title="Sju branscher, sju fullständiga exempel"
    intro="Varje sajt nedan är ett fiktivt demoföretag, men helt riktig, klickbar webbplats — byggd som om det vore en betalande kund inom just den branschen."
  />

  <section class="section section--tight">
    <div class="container grid grid-3">
      {
        cases.map((item) => (
          <a class="card" href={item.href} style="text-decoration: none; display: block;">
            <Placeholder label={item.industry} ratio="16 / 10" variant="accent" />
            <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
              <p class="badge">{item.industry}</p>
              <p class="badge">{item.tier}</p>
            </div>
            <h2 style="margin-top: 0.7rem; font-size: 1.15rem;">{item.name}</h2>
            <p style="margin-top: 0.5rem; font-size: 0.92rem; color: var(--fg-muted);">{item.text}</p>
            <p style="margin-top: 1rem; font-weight: 600; font-size: 0.92rem;">Besök demo →</p>
          </a>
        ))
      }
    </div>
  </section>
</HubLayout>
