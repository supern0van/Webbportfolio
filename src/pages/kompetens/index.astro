---
import HubLayout from "../../layouts/HubLayout.astro";
import PageHero from "../../components/PageHero.astro";

const groups = [
  {
    title: "Innehåll som fungerar",
    items: [
      "Tydlig struktur och rubriksättning som går att läsa i ett svep",
      "Text skriven för besökaren, inte för att fylla ut sidan",
      "Sökmotorvänlig grund: rätt titlar, beskrivningar och länkstruktur",
    ],
  },
  {
    title: "Fungerar för alla besökare",
    items: [
      "Tillräcklig färgkontrast och läsbar text i alla teman",
      "Tangentbords- och skärmläsarvänlig navigering",
      "Formulär med tydliga felmeddelanden, inte bara röda kanter",
    ],
  },
  {
    title: "Snabbt, på riktigt",
    items: [
      "Statiskt byggda sidor som laddar direkt, även på svagt mobilnät",
      "Bilder och komponenter laddas bara när de faktiskt behövs",
      "Ingen tung teknik som inte tillför något för besökaren",
    ],
  },
  {
    title: "Interaktion när det ger värde",
    items: [
      "Bokningsformulär med validering direkt i webbläsaren",
      "Filter och kalkylatorer byggda som lätta, fristående funktioner",
      "Alltid med ett fungerande, enkelt alternativ utan JavaScript",
    ],
  },
  {
    title: "Byggt för att underhållas",
    items: [
      "Ren, återanvändbar kod istället för sida-för-sida-kopiering",
      "Konsekvent namngivning så nästa ändring går snabbt att hitta",
      "Dokumentation av val som inte är självklara",
    ],
  },
  {
    title: "Samma trygghet som IT-supporten",
    items: [
      "Vi svarar på riktigt när något behöver ändras eller krånglar",
      "Rak kommunikation om vad som är möjligt inom given tid och budget",
      "Ingen låsning till plattformar ni inte förstår eller äger",
    ],
  },
];
---

<HubLayout
  title="Kompetens"
  description="Konkreta förmågor Nova IT tar med sig in i varje webbprojekt: tillgänglighet, prestanda, SEO och underhållbar kod."
>
  <PageHero
    eyebrow="Kompetens"
    title="Det som faktiskt märks för besökaren"
    intro="Vi radar inte upp verktygsnamn — här är vad de förmågorna faktiskt betyder i en sajt ni använder varje dag."
  />

  <section class="section section--tight">
    <div class="container grid grid-3">
      {
        groups.map((group) => (
          <div class="card">
            <h2 style="font-size: 1.1rem;">{group.title}</h2>
            <ul style="margin-top: 1rem; display: grid; gap: 0.6rem;">
              {group.items.map((item) => (
                <li style="display: flex; gap: 0.6rem; font-size: 0.92rem; color: var(--fg-muted);">
                  <span aria-hidden="true">–</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</HubLayout>
