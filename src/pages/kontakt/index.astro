---
import WebbportfolioLayout from "../../layouts/WebbportfolioLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<WebbportfolioLayout
  title="Kontakt"
  description="Vill du se hur en webbplats kan formas för din verksamhet? Hör av dig."
>
  <PageHero
    eyebrow="Kontakt"
    title="Vill du se hur en webbplats kan formas för din verksamhet?"
    intro="Hör av dig så kan vi prata om vilken typ av webbplats som passar bäst och vilka funktioner som faktiskt gör nytta."
  />

  <section class="section section--tight">
    <div class="container grid grid-2" style="align-items: start;">
      <div class="card">
        <ContactForm
          services={["Ny webbplats", "Vidareutveckling", "Fråga om en demo", "Annat"]}
          serviceLabel="Vad gäller det?"
        />
      </div>
      <div class="card">
        <h2 style="font-size: 1.05rem;">Om intresseanmälan</h2>
        <p class="form-note" style="margin-top: 0.75rem;">
          Formuläret här bredvid är en demoblankett i det här utkastet — inget skickas. När
          Webbportfolio publiceras kopplas en riktig kontaktväg in.
        </p>
        <p class="form-note" style="margin-top: 0.9rem;">
          Lämna inga känsliga eller verkliga personuppgifter i demot.
        </p>
      </div>
    </div>
  </section>
</WebbportfolioLayout>
