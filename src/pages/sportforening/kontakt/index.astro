---
import SportforeningLayout from "../../../layouts/SportforeningLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import ContactForm from "../../../components/ContactForm.astro";
---

<SportforeningLayout title="Kontakt" description="Kontakta IFK Lindholmen.">
  <PageHero eyebrow="Kontakt" title="Hör av dig till styrelsen" intro="För medlemskap, använd anmälningsformuläret istället." compact />

  <section class="section section--tight">
    <div class="container grid grid-2" style="align-items: start;">
      <div class="card">
        <ContactForm services={["Medlemskap", "Sponsring", "Övrigt"]} serviceLabel="Vad gäller det?" />
      </div>
      <div class="card">
        <h2 style="font-size: 1.05rem;">Föreningen</h2>
        <ul style="margin-top: 1rem; display: grid; gap: 0.7rem; font-size: 0.92rem; color: var(--fg-muted);">
          <li>Lindholmens IP, Göteborg</li>
          <li>styrelsen@ifklindholmen.se (exempel)</li>
          <li>Org.nr 802999-0005 (exempel)</li>
        </ul>
      </div>
    </div>
  </section>
</SportforeningLayout>
