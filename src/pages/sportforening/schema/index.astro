---
import SportforeningLayout from "../../../layouts/SportforeningLayout.astro";
import PageHero from "../../../components/PageHero.astro";

const sessions = [
  { team: "Knatteskola", day: "Måndag", time: "17:00–17:45", plan: "Konstgräs A" },
  { team: "Knatteskola", day: "Onsdag", time: "17:00–17:45", plan: "Konstgräs A" },
  { team: "P/F 9–12", day: "Måndag", time: "18:00–19:15", plan: "Konstgräs B" },
  { team: "P/F 9–12", day: "Torsdag", time: "18:00–19:15", plan: "Konstgräs B" },
  { team: "P/F 13–16", day: "Tisdag", time: "18:30–20:00", plan: "Konstgräs A" },
  { team: "P/F 13–16", day: "Fredag", time: "17:30–19:00", plan: "Konstgräs A" },
  { team: "Herrar & Damer A", day: "Måndag", time: "19:30–21:00", plan: "Konstgräs A" },
  { team: "Herrar & Damer A", day: "Onsdag", time: "19:30–21:00", plan: "Konstgräs A" },
  { team: "Herrar & Damer A", day: "Fredag", time: "19:00–20:30", plan: "Konstgräs B" },
  { team: "Veteranlag", day: "Tisdag", time: "20:00–21:00", plan: "Konstgräs B" },
  { team: "Motionsfotboll", day: "Onsdag", time: "20:00–21:00", plan: "Grusplan" },
];

const teams = [...new Set(sessions.map((s) => s.team))];
const days = ["Måndag", "Tisdag", "Onsdag", "Torsdag", "Fredag"];
---

<SportforeningLayout title="Träningsschema" description="Filtrerbart träningsschema för IFK Lindholmen.">
  <PageHero eyebrow="Schema" title="Träningstider" intro="Filtrera på lag eller veckodag för att hitta rätt pass." compact />

  <section class="section section--tight">
    <div class="container">
      <div class="field-row field-row--2" style="max-width: 40rem;">
        <div class="field">
          <label for="lag-filter">Lag</label>
          <select id="lag-filter" data-filter-team>
            <option value="alla">Alla lag</option>
            {teams.map((team) => <option value={team}>{team}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="dag-filter">Veckodag</label>
          <select id="dag-filter" data-filter-day>
            <option value="alla">Alla dagar</option>
            {days.map((day) => <option value={day}>{day}</option>)}
          </select>
        </div>
      </div>

      <div style="overflow-x: auto; margin-top: 1.5rem;">
        <table style="width: 100%; border-collapse: collapse; min-width: 36rem;">
          <thead>
            <tr style="text-align: left; border-bottom: 2px solid var(--border);">
              <th style="padding: 0.7rem 0.5rem;">Lag</th>
              <th style="padding: 0.7rem 0.5rem;">Dag</th>
              <th style="padding: 0.7rem 0.5rem;">Tid</th>
              <th style="padding: 0.7rem 0.5rem;">Plan</th>
            </tr>
          </thead>
          <tbody data-schedule-body>
            {
              sessions.map((session) => (
                <tr
                  data-team={session.team}
                  data-day={session.day}
                  style="border-bottom: 1px solid var(--border);"
                >
                  <td style="padding: 0.7rem 0.5rem;">{session.team}</td>
                  <td style="padding: 0.7rem 0.5rem;">{session.day}</td>
                  <td style="padding: 0.7rem 0.5rem;">{session.time}</td>
                  <td style="padding: 0.7rem 0.5rem; color: var(--fg-muted);">{session.plan}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="form-note" data-empty-note hidden>Inga pass matchar det urvalet.</p>
      </div>
    </div>
  </section>
</SportforeningLayout>

<script>
  const teamFilter = document.querySelector<HTMLSelectElement>("[data-filter-team]");
  const dayFilter = document.querySelector<HTMLSelectElement>("[data-filter-day]");
  const rows = document.querySelectorAll<HTMLTableRowElement>("[data-schedule-body] tr");
  const emptyNote = document.querySelector<HTMLElement>("[data-empty-note]");

  function applyFilters() {
    const team = teamFilter?.value ?? "alla";
    const day = dayFilter?.value ?? "alla";
    let visibleCount = 0;

    rows.forEach((row) => {
      const matchesTeam = team === "alla" || row.dataset.team === team;
      const matchesDay = day === "alla" || row.dataset.day === day;
      const visible = matchesTeam && matchesDay;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (emptyNote) emptyNote.hidden = visibleCount > 0;
  }

  teamFilter?.addEventListener("change", applyFilters);
  dayFilter?.addEventListener("change", applyFilters);
</script>
