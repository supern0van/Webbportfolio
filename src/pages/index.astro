---
import HubLayout from "../layouts/HubLayout.astro";
import Placeholder from "../components/Placeholder.astro";

const highlights = [
  { name: "Ek & Sten Bygg", industry: "Hantverkare", href: "/hantverkare/" },
  { name: "Restaurang Björk", industry: "Restaurang", href: "/restaurang/" },
  { name: "Lindqvist & Partners", industry: "Advokatbyrå", href: "/advokatbyra/" },
  { name: "IFK Lindholmen", industry: "Sportförening", href: "/sportforening/" },
];
---

<HubLayout
  title="Webbutveckling"
  description="Nova IT bygger webbplatser för olika typer av företag och föreningar — se exempel på vad vi kan göra."
>
  <section class="section">
    <div class="container" style="display: grid; gap: 3rem; align-items: center; grid-template-columns: 1fr;">
      <div>
        <p class="eyebrow">Nova IT · Webbutveckling</p>
        <h1 style="font-size: clamp(2.4rem, 5vw, 3.6rem); max-width: 38rem;">
          Vi bygger sajter lika pålitligt som vi sköter er IT.
        </h1>
        <p class="lede" style="margin-top: 1.2rem;">
          Nova IT är känt för praktisk IT-support, nätverk och säkerhet. Samma
          raka, lugna arbetssätt använder vi när vi bygger webbplatser — från
          enkla enskilda sidor till bokningsflöden och kalkylatorer, till
          vilken typ av verksamhet det än gäller.
        </p>
        <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
          <a class="btn btn-primary" href="/kundtyper/">Se vad vi kan bygga</a>
          <a class="btn btn-secondary" href="/kontakt/">Boka ett samtal</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" style="border-top: 1px solid var(--border);">
    <div class="container">
      <p class="eyebrow">Exempel</p>
      <h2 style="font-size: clamp(1.6rem, 3vw, 2.2rem);">Fyra branscher, fyra helt olika sajter</h2>
      <p class="lede" style="margin-top: 0.75rem;">
        Alla exempel nedan är fiktiva demoföretag som vi byggt fullständiga,
        flersidiga sajter för — för att visa spridningen i vad vi kan leverera.
      </p>
      <div class="grid grid-4" style="margin-top: 2rem;">
        {
          highlights.map((item) => (
            <a class="card" href={item.href} style="text-decoration: none; display: block;">
              <Placeholder label={item.industry} ratio="4 / 3" variant="primary" />
              <p class="badge" style="margin-top: 1rem;">{item.industry}</p>
              <h3 style="margin-top: 0.6rem; font-size: 1.05rem;">{item.name}</h3>
            </a>
          ))
        }
      </div>
      <p style="margin-top: 1.75rem;">
        <a class="btn btn-secondary" href="/kundtyper/">Se alla sju exempel →</a>
      </p>
    </div>
  </section>

  <section class="section" style="border-top: 1px solid var(--border);">
    <div class="container grid grid-2" style="align-items: start;">
      <div>
        <p class="eyebrow">Så jobbar vi</p>
        <h2 style="font-size: clamp(1.6rem, 3vw, 2.2rem);">Tre nivåer, samma omsorg</h2>
        <p class="lede" style="margin-top: 0.75rem;">
          Ni behöver inte veta vilken teknik ni vill ha — bara vad sajten
          faktiskt ska göra. Vi föreslår en nivå utifrån det.
        </p>
      </div>
      <div class="grid" style="gap: 1rem;">
        <div class="card">
          <h3 style="font-size: 1.05rem;">Bas</h3>
          <p class="form-note" style="margin-top: 0.4rem;">
            En sida som gör jobbet — för enskilda företagare som behöver synas online.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: 1.05rem;">Standard</h3>
          <p class="form-note" style="margin-top: 0.4rem;">
            Flera sidor, tydlig struktur — tjänster, referenser och kontaktvägar.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: 1.05rem;">Premium</h3>
          <p class="form-note" style="margin-top: 0.4rem;">
            Bokning, kalkylatorer och andra interaktiva flöden byggda in i sajten.
          </p>
        </div>
      </div>
      <p style="grid-column: 1 / -1;">
        <a class="btn btn-secondary" href="/tjanster/">Läs mer om tjänsterna →</a>
      </p>
    </div>
  </section>
</HubLayout>
