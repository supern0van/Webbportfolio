---
import RestaurangLayout from "../../../layouts/RestaurangLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import ContactForm from "../../../components/ContactForm.astro";
---

<RestaurangLayout title="Kontakt" description="Kontakta Restaurang Björk.">
  <PageHero eyebrow="Kontakt" title="Hör av dig" intro="För stora sällskap, catering eller allmänna frågor." compact />

  <section class="section section--tight">
    <div class="container grid grid-2" style="align-items: start;">
      <div class="card">
        <ContactForm
          services={["Bordsbokning över 8 personer", "Catering", "Allmän fråga"]}
          serviceLabel="Vad gäller det?"
        />
      </div>
      <div class="card">
        <h2 style="font-size: 1.05rem;">Besök oss</h2>
        <ul style="margin-top: 1rem; display: grid; gap: 0.7rem; font-size: 0.92rem; color: var(--fg-muted);">
          <li>Södra vägen 4, Göteborg (exempel)</li>
          <li>Tis–lör 17–22, sön 13–20</li>
          <li>bord@restaurangbjork.se (exempel)</li>
        </ul>
      </div>
    </div>
  </section>
</RestaurangLayout>
