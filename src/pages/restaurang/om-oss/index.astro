---
import RestaurangLayout from "../../../layouts/RestaurangLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Placeholder from "../../../components/Placeholder.astro";
---

<RestaurangLayout title="Om oss" description="Historien bakom Restaurang Björk.">
  <PageHero
    eyebrow="Om oss"
    title="En liten restaurang med stora råvaror"
    intro="Restaurang Björk öppnade 2019 i en gammal repslagarbod. Vi lagar allt från grunden, i ett kök där man kan se in från matsalen."
  />

  <section class="section section--tight">
    <div class="container grid grid-2" style="align-items: center;">
      <Placeholder label="Köket" ratio="4 / 3" variant="accent" />
      <p style="color: var(--fg-muted);">
        Namnet kommer från björken som står utanför entrén — den syns från
        nästan alla bord. Vi jobbar med lokala odlare och fiskare, och byter
        menyn i takt med säsongen istället för att jaga trender.
      </p>
    </div>
  </section>
</RestaurangLayout>
