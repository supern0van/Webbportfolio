---
import RestaurangLayout from "../../../layouts/RestaurangLayout.astro";
import PageHero from "../../../components/PageHero.astro";
---

<RestaurangLayout title="Boka bord" description="Boka bord på Restaurang Björk.">
  <PageHero
    eyebrow="Boka bord"
    title="Reservera ett bord"
    intro="Fyll i uppgifterna nedan. För sällskap över 8 personer, kontakta oss direkt istället."
    compact
  />

  <section class="section section--tight">
    <div class="container" style="max-width: 34rem;">
      <div class="card">
        <form class="contact-form" data-booking-form novalidate>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="datum">Datum</label>
              <input id="datum" name="datum" type="date" required />
            </div>
            <div class="field">
              <label for="tid">Tid</label>
              <select id="tid" name="tid" required>
                <option value="">Välj tid</option>
                <option>17:00</option>
                <option>17:30</option>
                <option>18:00</option>
                <option>18:30</option>
                <option>19:00</option>
                <option>19:30</option>
                <option>20:00</option>
                <option>20:30</option>
              </select>
            </div>
          </div>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="antal">Antal gäster</label>
              <input id="antal" name="antal" type="number" min="1" max="8" value="2" required />
            </div>
            <div class="field">
              <label for="namn">Namn</label>
              <input id="namn" name="namn" type="text" required />
            </div>
          </div>
          <div class="field">
            <label for="telefon">Telefonnummer</label>
            <input id="telefon" name="telefon" type="tel" required />
          </div>
          <div class="field">
            <label for="onskemal">Önskemål (valfritt)</label>
            <textarea id="onskemal" name="onskemal" rows="3"></textarea>
          </div>
          <button class="btn btn-primary" type="submit">Boka bord</button>
          <p class="form-note">
            Demoformulär — bokningen skickas inte till någon, den visar bara flödet.
          </p>
          <p class="form-success" data-form-success hidden role="status">
            Tack! Bordet är preliminärbokat — vi bekräftar via sms.
          </p>
        </form>
      </div>
    </div>
  </section>
</RestaurangLayout>

<script>
  const dateInput = document.querySelector<HTMLInputElement>('[data-booking-form] input[type="date"]');
  if (dateInput) {
    dateInput.min = new Date().toISOString().split("T")[0];
  }

  const form = document.querySelector<HTMLFormElement>("[data-booking-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const success = form.querySelector<HTMLElement>("[data-form-success]");
    if (success) success.hidden = false;
    form.reset();
  });
</script>
