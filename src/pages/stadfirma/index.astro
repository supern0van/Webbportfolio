---
import StadfirmaLayout from "../../layouts/StadfirmaLayout.astro";
import Placeholder from "../../components/Placeholder.astro";
---

<StadfirmaLayout
  title="Städfirma i Storgöteborg"
  description="Klarblick Städ erbjuder hemstäd, flyttstäd och kontorsstäd i Storgöteborg med RUT-avdrag."
>
  <section class="section">
    <div class="container grid grid-2" style="align-items: center;">
      <div>
        <p class="eyebrow">Klarblick Städ</p>
        <h1 style="font-size: clamp(2.2rem, 5vw, 3.3rem);">Rent utan att ni behöver tänka på det.</h1>
        <p class="lede" style="margin-top: 1.1rem;">
          Hemstäd, flyttstäd och kontorsstäd — med fast pris ni ser direkt,
          innan ni bokar. RUT-avdraget dras automatiskt på hemstäd.
        </p>
        <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
          <a class="btn btn-primary" href="/stadfirma/offertkalkylator/">Beräkna pris</a>
          <a class="btn btn-secondary" href="/stadfirma/tjanster/">Se tjänster</a>
        </div>
      </div>
      <Placeholder label="Städat hem" ratio="4 / 3" variant="primary" />
    </div>
  </section>

  <section class="section section--tight" style="border-top: 1px solid var(--border);">
    <div class="container grid grid-3">
      <div class="card">
        <h2 style="font-size: 1.05rem;">Hemstäd</h2>
        <p style="margin-top: 0.6rem; color: var(--fg-muted); font-size: 0.92rem;">Löpande städ, varannan eller var fjärde vecka.</p>
      </div>
      <div class="card">
        <h2 style="font-size: 1.05rem;">Flyttstäd</h2>
        <p style="margin-top: 0.6rem; color: var(--fg-muted); font-size: 0.92rem;">Med besiktningsgaranti inför avflyttning.</p>
      </div>
      <div class="card">
        <h2 style="font-size: 1.05rem;">Kontorsstäd</h2>
        <p style="margin-top: 0.6rem; color: var(--fg-muted); font-size: 0.92rem;">Kvälls- eller morgonstäd, valfri frekvens.</p>
      </div>
    </div>
  </section>
</StadfirmaLayout>
