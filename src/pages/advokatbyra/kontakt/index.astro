---
import AdvokatbyraLayout from "../../../layouts/AdvokatbyraLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import ContactForm from "../../../components/ContactForm.astro";
---

<AdvokatbyraLayout
  title="Kontakt"
  description="Boka ett inledande möte med Lindqvist & Partners Advokatbyrå."
>
  <PageHero
    eyebrow="Kontakt"
    title="Boka ett inledande möte"
    intro="Beskriv ärendet kort så återkommer vi med besked om vi kan ta oss an det och vad ett första möte skulle kosta."
    compact
  />

  <section class="section section--tight">
    <div class="container grid grid-2" style="align-items: start;">
      <div class="card">
        <ContactForm
          services={["Affärsjuridik", "Fastighet & hyresrätt", "Familjerätt", "Arbetsrätt", "Annat"]}
          serviceLabel="Vilket område gäller det?"
          submitLabel="Skicka förfrågan"
        />
      </div>
      <div class="card">
        <h2 style="font-size: 1.05rem;">Byrån</h2>
        <ul style="margin-top: 1rem; display: grid; gap: 0.7rem; font-size: 0.92rem; color: var(--fg-muted);">
          <li>Kungsportsavenyn 12, Göteborg</li>
          <li>08–17 vardagar</li>
          <li>info@lindqvistpartners.se (exempel)</li>
        </ul>
      </div>
    </div>
  </section>
</AdvokatbyraLayout>
