---
import AdvokatbyraLayout from "../../../layouts/AdvokatbyraLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Placeholder from "../../../components/Placeholder.astro";

const team = [
  { name: "Anna Lindqvist", role: "Advokat, delägare — affärsjuridik" },
  { name: "Marcus Eek", role: "Advokat, delägare — familjerätt" },
  { name: "Sara Holm", role: "Biträdande jurist — arbetsrätt" },
];
---

<AdvokatbyraLayout
  title="Om oss"
  description="Möt teamet bakom Lindqvist & Partners Advokatbyrå."
>
  <PageHero
    eyebrow="Om oss"
    title="Ett litet team, väl valda ärenden"
    intro="Lindqvist & Partners grundades för att kunna arbeta nära varje klient — inte för att växa så fort som möjligt."
  />

  <section class="section section--tight">
    <div class="container grid grid-3">
      {
        team.map((person) => (
          <div class="card">
            <Placeholder label={person.name} ratio="1 / 1" variant="primary" />
            <h2 style="margin-top: 1rem; font-size: 1.05rem;">{person.name}</h2>
            <p style="margin-top: 0.3rem; color: var(--fg-muted); font-size: 0.9rem;">{person.role}</p>
          </div>
        ))
      }
    </div>
  </section>
</AdvokatbyraLayout>
