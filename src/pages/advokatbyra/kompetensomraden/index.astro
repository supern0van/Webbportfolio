---
import AdvokatbyraLayout from "../../../layouts/AdvokatbyraLayout.astro";
import PageHero from "../../../components/PageHero.astro";

const areas = [
  {
    name: "Affärsjuridik",
    text: "Vi hjälper företag med avtal, bolagsstyrning, förvärv och tvister. Många av våra klienter är ägarledda bolag som behöver en jurist de kan ringa direkt, utan omvägar.",
  },
  {
    name: "Fastighet & hyresrätt",
    text: "Överlåtelser, hyrestvister, nyttjanderätter och entreprenadfrågor. Vi företräder både fastighetsägare och hyresgäster.",
  },
  {
    name: "Familjerätt",
    text: "Vårdnad, boende och umgänge, bodelning, äktenskapsförord och arv. Vi lägger stor vikt vid att förklara vad som faktiskt är möjligt innan en process inleds.",
  },
  {
    name: "Arbetsrätt",
    text: "Uppsägningar, anställningsavtal, omorganisationer och tvister på arbetsplatsen — för både arbetsgivare och arbetstagare.",
  },
];
---

<AdvokatbyraLayout
  title="Kompetensområden"
  description="Affärsjuridik, fastighetsrätt, familjerätt och arbetsrätt hos Lindqvist & Partners."
>
  <PageHero
    eyebrow="Kompetensområden"
    title="Fyra områden vi verkligen kan"
    intro="Vi tar medvetet inte an alla typer av ärenden. Inom de här fyra områdena har vi den erfarenhet som krävs för att ge ett tydligt, träffsäkert råd direkt."
  />

  <section class="section section--tight">
    <div class="container" style="display: grid; gap: 1.5rem;">
      {
        areas.map((area) => (
          <div class="card" style="display: grid; gap: 0.6rem; grid-template-columns: 1fr; max-width: 44rem;">
            <h2 style="font-size: 1.2rem;">{area.name}</h2>
            <p style="color: var(--fg-muted);">{area.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</AdvokatbyraLayout>
