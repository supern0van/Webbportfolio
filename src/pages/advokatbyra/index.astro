---
import AdvokatbyraLayout from "../../layouts/AdvokatbyraLayout.astro";
import Placeholder from "../../components/Placeholder.astro";

const areas = [
  { name: "Affärsjuridik", text: "Avtal, bolagsfrågor och tvister för små och medelstora företag." },
  { name: "Fastighet & hyresrätt", text: "Överlåtelser, hyrestvister och nyttjanderätt." },
  { name: "Familjerätt", text: "Vårdnad, boende, umgänge, bodelning och äktenskapsförord." },
  { name: "Arbetsrätt", text: "Uppsägningar, anställningsavtal och tvister på arbetsplatsen." },
];
---

<AdvokatbyraLayout
  title="Advokatbyrå i Göteborg"
  description="Lindqvist & Partners är en advokatbyrå som arbetar med affärsjuridik, fastighetsrätt, familjerätt och arbetsrätt."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Lindqvist & Partners</p>
      <h1 style="font-size: clamp(2.1rem, 4.5vw, 3.2rem); max-width: 34rem;">
        Tydliga besked när det verkligen betyder något.
      </h1>
      <p class="lede" style="margin-top: 1.1rem;">
        Vi företräder både företag och privatpersoner, med en rak
        kommunikationsstil och ett tydligt svar på vad som är realistiskt att
        uppnå — och vad det kommer att kosta.
      </p>
      <p style="margin-top: 2rem;">
        <a class="btn btn-primary" href="/advokatbyra/kontakt/">Boka ett inledande möte</a>
      </p>
    </div>
  </section>

  <section class="section section--tight" style="border-top: 1px solid var(--border);">
    <div class="container">
      <p class="eyebrow">Kompetensområden</p>
      <h2 style="font-size: clamp(1.6rem, 3vw, 2.1rem);">Fyra områden, en byrå</h2>
      <div class="grid grid-2" style="margin-top: 2rem;">
        {
          areas.map((area) => (
            <div class="card">
              <h3 style="font-size: 1.1rem;">{area.name}</h3>
              <p style="margin-top: 0.6rem; color: var(--fg-muted);">{area.text}</p>
            </div>
          ))
        }
      </div>
      <p style="margin-top: 1.75rem;">
        <a class="btn btn-secondary" href="/advokatbyra/kompetensomraden/">Läs mer om områdena →</a>
      </p>
    </div>
  </section>

  <section class="section" style="border-top: 1px solid var(--border);">
    <div class="container grid grid-2" style="align-items: center;">
      <Placeholder label="Konferensrum" ratio="4 / 3" variant="accent" />
      <div>
        <p class="eyebrow">Om byrån</p>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem);">Grundad på förtroende, inte volym</h2>
        <p style="margin-top: 1rem; color: var(--fg-muted);">
          Vi tar oss an färre ärenden i taget för att kunna vara tillgängliga
          genom hela processen — från första samtalet till avslutat ärende.
        </p>
        <p style="margin-top: 1.25rem;">
          <a class="btn btn-secondary" href="/advokatbyra/om-oss/">Om oss →</a>
        </p>
      </div>
    </div>
  </section>
</AdvokatbyraLayout>
