---
import KonsultLayout from "../../../layouts/KonsultLayout.astro";
import Placeholder from "../../../components/Placeholder.astro";
import ContactForm from "../../../components/ContactForm.astro";

const problems = [
  { title: "Otydlig prioritering", text: "Ledningen är oense om vad som faktiskt ska göras först." },
  { title: "Svaga processer", text: "Arbetet tappar fart mellan team och avdelningar." },
  { title: "Splittrad kundresa", text: "Kunden möter olika besked beroende på vem de pratar med." },
];

const offers = [
  { title: "Prioriteringsmodell", text: "En gemensam modell för att rangordna initiativ efter effekt och risk." },
  { title: "Processöversyn", text: "Kartläggning av var arbetet fastnar och vad som bör förenklas." },
  { title: "Kundresekartläggning", text: "En samlad bild av kundens väg genom er organisation." },
];

const process = [
  { step: "1", title: "Förstudie", text: "Vi kartlägger nuläge, mål och begränsningar tillsammans." },
  { step: "2", title: "Analys", text: "Vi identifierar de tre-fyra beslut som väger tyngst." },
  { step: "3", title: "Rekommendation", text: "Ett konkret, prioriterat förslag — inte en hyllvärmare." },
  { step: "4", title: "Uppföljning", text: "Vi stämmer av resultat och justerar vid behov." },
];

const cases = [
  { title: "Exempelcase — tillväxtbolag", text: "Tydlig kvartalsprioritering på fyra veckor.", tag: "Prioritering" },
  { title: "Exempelcase — tillverkningsföretag", text: "Kortare ledtid genom färre handoffs.", tag: "Process" },
  { title: "Exempelcase — tjänsteföretag", text: "Kundens kontaktvägar minskade från sex till tre.", tag: "Kundresa" },
];
---

<KonsultLayout
  title="Nordstrategi"
  description="Tydligare beslut när verksamheten växer — en B2B-konsultdemo från Webbportfolio."
>
  <section class="section" style="padding-top: clamp(3rem, 7vw, 6rem);">
    <div class="container" style="max-width: 42rem;">
      <p class="eyebrow">Nordstrategi · konceptdemo</p>
      <h1 style="font-size: clamp(2.1rem, 4.5vw, 3.1rem);">Tydligare beslut när verksamheten växer.</h1>
      <p class="lede" style="margin-top: 1.1rem; color: var(--fg);">
        En konsultdemo för bolag som behöver förklara erbjudanden, process och resultat på ett sätt
        som känns konkret.
      </p>
      <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
        <a class="btn btn-primary" href="#kontakt">Boka förstudie</a>
        <a class="btn btn-secondary" href="#process">Se arbetssätt</a>
      </div>
    </div>
  </section>

  <section class="section section--tight" style="border-top: 1px solid var(--border);">
    <div class="container">
      <p class="eyebrow">Tre problem vi känner igen</p>
      <div class="grid grid-3" style="margin-top: 1.5rem;">
        {
          problems.map((p) => (
            <div class="card">
              <h2 style="font-size: 1.05rem;">{p.title}</h2>
              <p class="form-note" style="margin-top: 0.6rem;">{p.text}</p>
            </div>
          ))
        }
      </div>
      <p class="form-note" style="margin-top: 1.25rem;">
        Öppna "Anpassa sidan" högst upp och välj det problem ni känner igen — erbjudande, case och
        förstudiefrågor anpassas efter valet.
      </p>
    </div>
  </section>

  <section class="section" style="border-top: 1px solid var(--border); background: var(--bg-alt);">
    <div class="container">
      <p class="eyebrow">Erbjudanden</p>
      <h2 style="font-size: clamp(1.5rem, 3vw, 2rem);">Vad vi levererar</h2>
      <div class="grid grid-3" style="margin-top: 2rem;">
        {
          offers.map((o) => (
            <div class="card" style="background: var(--card);">
              <h3 style="font-size: 1.02rem;">{o.title}</h3>
              <p class="form-note" style="margin-top: 0.6rem;">{o.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="process" class="section" style="border-top: 1px solid var(--border);">
    <div class="container">
      <p class="eyebrow">Arbetsprocess</p>
      <h2 style="font-size: clamp(1.5rem, 3vw, 2rem);">Fyra steg, ett tydligt beslutsunderlag</h2>
      <ol style="margin-top: 2rem; display: grid; gap: 1.25rem;">
        {
          process.map((step) => (
            <li style="display: flex; gap: 1.25rem; align-items: baseline; border-bottom: 1px solid var(--border); padding-bottom: 1.1rem;">
              <span style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--primary); flex-shrink: 0; width: 2rem;">
                {step.step}
              </span>
              <div>
                <h3 style="font-size: 1.02rem;">{step.title}</h3>
                <p class="form-note" style="margin-top: 0.35rem;">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="case" class="section" style="border-top: 1px solid var(--border); background: var(--bg-alt);">
    <div class="container">
      <p class="eyebrow">Exempelcase</p>
      <h2 style="font-size: clamp(1.5rem, 3vw, 2rem);">Fiktiva resultat, redovisade ärligt</h2>
      <p class="lede" style="margin-top: 0.75rem;">Case nedan är fiktiva exempel och presenteras inte som verkliga kundutfall.</p>
      <ul style="margin-top: 2rem; display: grid; gap: 1rem;">
        {
          cases.map((c) => (
            <li class="card" style="background: var(--card); display: flex; justify-content: space-between; gap: 1.5rem; align-items: baseline; flex-wrap: wrap;">
              <div>
                <h3 style="font-size: 1.02rem;">{c.title}</h3>
                <p class="form-note" style="margin-top: 0.4rem;">{c.text}</p>
              </div>
              <span class="badge">{c.tag}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="kontakt" class="section" style="border-top: 1px solid var(--border);">
    <div class="container grid grid-2" style="align-items: start;">
      <div>
        <p class="eyebrow">Kontakt för möte</p>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem);">Boka förstudie</h2>
        <p class="lede" style="margin-top: 0.75rem;">
          Formuläret är en demo i det här utkastet — inget skickas eller sparas.
        </p>
        <Placeholder label="Arbetsmöte, diagram och beslutsunderlag" ratio="4 / 3" variant="accent" />
      </div>
      <div class="card" style="background: var(--card);">
        <ContactForm
          services={["Prioriteringsmodell", "Processöversyn", "Kundresekartläggning", "Annat"]}
          serviceLabel="Vilket område gäller det?"
          submitLabel="Skicka förfrågan"
          successText="Tack! Det här är en demo — inget har skickats."
        />
      </div>
    </div>
  </section>
</KonsultLayout>
