---
import "../styles/tokens-sportforening.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoBanner from "../components/DemoBanner.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const navLinks = [
  { label: "Hem", href: "/sportforening/" },
  { label: "Verksamhet", href: "/sportforening/verksamhet/" },
  { label: "Schema", href: "/sportforening/schema/" },
  { label: "Bli medlem", href: "/sportforening/bli-medlem/" },
  { label: "Kontakt", href: "/sportforening/kontakt/" },
];
---

<BaseLayout
  title={`${title} — IFK Lindholmen`}
  description={description}
  favicon="/favicon-sportforening.svg"
>
  <DemoBanner industry="sportförening" />
  <Header
    siteName="IFK Lindholmen"
    homeHref="/sportforening/"
    navLinks={navLinks}
    currentPath={Astro.url.pathname}
    ctaLabel="Bli medlem"
    ctaHref="/sportforening/bli-medlem/"
  />

  <main id="innehall">
    <slot />
  </main>

  <Footer
    siteName="IFK Lindholmen"
    tagline="Fotbollsförening för alla åldrar sedan 1974."
    orgLine="Ideell förening (exempel)."
    columns={[
      {
        heading: "Föreningen",
        links: [
          { label: "Verksamhet", href: "/sportforening/verksamhet/" },
          { label: "Schema", href: "/sportforening/schema/" },
        ],
      },
      {
        heading: "Gå med",
        links: [{ label: "Bli medlem", href: "/sportforening/bli-medlem/" }],
      },
    ]}
  />
</BaseLayout>
