---
import "../styles/tokens-stadfirma.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoBanner from "../components/DemoBanner.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const navLinks = [
  { label: "Hem", href: "/stadfirma/" },
  { label: "Tjänster", href: "/stadfirma/tjanster/" },
  { label: "Offertkalkylator", href: "/stadfirma/offertkalkylator/" },
  { label: "Om oss", href: "/stadfirma/om-oss/" },
  { label: "Kontakt", href: "/stadfirma/kontakt/" },
];
---

<BaseLayout
  title={`${title} — Klarblick Städ`}
  description={description}
  favicon="/favicon-stadfirma.svg"
>
  <DemoBanner industry="städfirma" />
  <Header
    siteName="Klarblick Städ"
    homeHref="/stadfirma/"
    navLinks={navLinks}
    currentPath={Astro.url.pathname}
    ctaLabel="Beräkna pris"
    ctaHref="/stadfirma/offertkalkylator/"
  />

  <main id="innehall">
    <slot />
  </main>

  <Footer
    siteName="Klarblick Städ"
    tagline="Hemstäd, flyttstäd och kontorsstäd i Storgöteborg."
    orgLine="Org.nr 559999-0004 (exempel). RUT-avdrag tillämpas."
    columns={[
      {
        heading: "Bolaget",
        links: [
          { label: "Tjänster", href: "/stadfirma/tjanster/" },
          { label: "Om oss", href: "/stadfirma/om-oss/" },
        ],
      },
      {
        heading: "Kom igång",
        links: [{ label: "Offertkalkylator", href: "/stadfirma/offertkalkylator/" }],
      },
    ]}
  />
</BaseLayout>
