---
import "../styles/tokens-restaurang.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoBanner from "../components/DemoBanner.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const navLinks = [
  { label: "Hem", href: "/restaurang/" },
  { label: "Meny", href: "/restaurang/meny/" },
  { label: "Om oss", href: "/restaurang/om-oss/" },
  { label: "Kontakt", href: "/restaurang/kontakt/" },
];
---

<BaseLayout
  title={`${title} — Restaurang Björk`}
  description={description}
  favicon="/favicon-restaurang.svg"
>
  <DemoBanner industry="restaurang" />
  <Header
    siteName="Restaurang Björk"
    homeHref="/restaurang/"
    navLinks={navLinks}
    currentPath={Astro.url.pathname}
    ctaLabel="Boka bord"
    ctaHref="/restaurang/boka-bord/"
  />

  <main id="innehall">
    <slot />
  </main>

  <Footer
    siteName="Restaurang Björk"
    tagline="Säsongsbaserad husmanskost mitt i Göteborg."
    orgLine="Org.nr 559999-0001 (exempel)."
    columns={[
      {
        heading: "Restaurangen",
        links: [
          { label: "Meny", href: "/restaurang/meny/" },
          { label: "Om oss", href: "/restaurang/om-oss/" },
        ],
      },
      {
        heading: "Boka",
        links: [{ label: "Boka bord", href: "/restaurang/boka-bord/" }],
      },
    ]}
  />
</BaseLayout>
