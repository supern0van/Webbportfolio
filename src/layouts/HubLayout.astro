---
import "../styles/tokens-hub.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const navLinks = [
  { label: "Hem", href: "/" },
  { label: "Tjänster", href: "/tjanster/" },
  { label: "Kompetens", href: "/kompetens/" },
  { label: "Kundtyper", href: "/kundtyper/" },
  { label: "Om oss", href: "/om-oss/" },
  { label: "Kontakt", href: "/kontakt/" },
];
---

<BaseLayout title={`${title} — Nova IT`} description={description} favicon="/nova-it-mark.svg">
  <Header
    siteName="Nova IT"
    homeHref="/"
    navLinks={navLinks}
    currentPath={Astro.url.pathname}
    ctaLabel="Boka ett samtal"
    ctaHref="/kontakt/"
  >
    <img slot="logo" src="/nova-it-mark.svg" alt="" width="32" height="32" />
  </Header>

  <main id="innehall">
    <slot />
  </main>

  <Footer
    siteName="Nova IT"
    tagline="IT-support och webbutveckling med samma lugna, pålitliga känsla."
    orgLine="Alla rättigheter förbehållna."
    columns={[
      {
        heading: "Webbutveckling",
        links: [
          { label: "Tjänster", href: "/tjanster/" },
          { label: "Kompetens", href: "/kompetens/" },
          { label: "Kundtyper", href: "/kundtyper/" },
        ],
      },
      {
        heading: "Företaget",
        links: [
          { label: "Om oss", href: "/om-oss/" },
          { label: "Kontakt", href: "/kontakt/" },
        ],
      },
    ]}
  />
</BaseLayout>
