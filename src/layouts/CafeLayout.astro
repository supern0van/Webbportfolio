---
import "../styles/tokens-cafe.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoDock from "../components/DemoDock.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const navLinks = [
  { label: "Hem", href: "/demo/cafe/" },
  { label: "Menyn", href: "/demo/cafe/#meny" },
  { label: "Evenemang", href: "/demo/cafe/#evenemang" },
  { label: "Kontakt", href: "/demo/cafe/#kontakt" },
];
---

<BaseLayout
  title={`${title} — Kvarterets Koppar`}
  description={description}
  favicon="/favicon-cafe.svg"
>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Karla:wght@400;500;600&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <DemoDock demoName="Cafédemo" statusLabel="Färdig demo" backHref="/webbplatser/">
    <Fragment slot="panel">
      <p class="eyebrow" style="color: #f5f7f6;">Anpassa sidan</p>
      <h2 style="color: #fff; font-size: 1.2rem; margin-bottom: 0.25rem;">Prova funktioner i cafédemon</h2>
      <p class="form-note" style="color: rgba(245,247,246,0.75); max-width: 38rem;">
        Testa hur olika funktioner kan förändra en webbplats. Funktionerna visas som koncept eller
        simuleringar, inte som aktiva externa tjänster.
      </p>

      <div style="margin-top: 1.5rem;">
        <p style="font-weight: 600; color: #fff; margin-bottom: 0.6rem;">Byt mellan varm, modern och exklusiv stil</p>
        <div class="dock-options">
          <button type="button" class="dock-option" aria-pressed="true" data-dock-option data-group="stil" data-reveal="stil-varm">Varm</button>
          <button type="button" class="dock-option" aria-pressed="false" data-dock-option data-group="stil" data-reveal="stil-modern" data-apply-attr="data-cafe-style" data-apply-value="modern">Modern</button>
          <button type="button" class="dock-option" aria-pressed="false" data-dock-option data-group="stil" data-reveal="stil-exklusiv" data-apply-attr="data-cafe-style" data-apply-value="exklusiv">Exklusiv</button>
          <button type="button" class="dock-reset" data-dock-reset data-group="stil">Återställ</button>
        </div>
        <div id="stil-varm" class="dock-detail" data-detail-group="stil">
          <strong>Varm</strong>
          Mjuka toner, naturligt ljus och en personlig känsla — cafédemons ursprungsläge.
        </div>
        <div id="stil-modern" class="dock-detail" data-detail-group="stil" hidden>
          <strong>Modern</strong>
          Renare layout, mer kontrast och mindre dekor. Hela sidan byter typsnittston, färg och
          bildton samtidigt.
        </div>
        <div id="stil-exklusiv" class="dock-detail" data-detail-group="stil" hidden>
          <strong>Exklusiv</strong>
          Mörkare detaljer, mer premiumkänsla och en mer återhållsam copy.
        </div>
      </div>

      <div style="margin-top: 1.75rem; display: grid; gap: 1.25rem;" class="grid grid-2">
        <div>
          <p style="font-weight: 600; color: #fff; margin-bottom: 0.6rem;">Lägg till bokningskalender</p>
          <div class="dock-options">
            <button type="button" class="dock-option" aria-pressed="false" data-dock-option data-group="bokning" data-reveal="bokning-detalj">Visa bokning</button>
          </div>
          <div id="bokning-detalj" class="dock-detail" data-detail-group="bokning" hidden>
            <strong>Bokning minskar behovet av telefonsamtal</strong>
            En kalenderliknande modul visas som platshållare. Demo — ingen bokning skickas, ingen
            extern bokningstjänst är inkopplad.
          </div>
        </div>
        <div>
          <p style="font-weight: 600; color: #fff; margin-bottom: 0.6rem;">Lägg till kundomdömen</p>
          <div class="dock-options">
            <button type="button" class="dock-option" aria-pressed="false" data-dock-option data-group="omdome" data-reveal="omdome-detalj">Visa omdömen</button>
          </div>
          <div id="omdome-detalj" class="dock-detail" data-detail-group="omdome" hidden>
            <strong>Kundomdömen kan skapa förtroende</strong>
            Exempelomdömen: "Bästa kardemummabullen i kvarteret." / "Lugn plats att jobba från på
            förmiddagen." Fiktiva citat, inga verkliga gäster.
          </div>
        </div>
      </div>

      <p class="dock-notice">Demo — inga val här kopplar till en verklig tjänst eller skickar data.</p>
    </Fragment>
  </DemoDock>

  <Header
    siteName="Kvarterets Koppar"
    homeHref="/demo/cafe/"
    navLinks={navLinks}
    currentPath={Astro.url.pathname}
    ctaLabel="Se menyn"
    ctaHref="/demo/cafe/#meny"
  />

  <main id="innehall">
    <slot />
  </main>

  <Footer
    siteName="Kvarterets Koppar"
    tagline="Konceptdemo skapad av Webbportfolio – ett projekt från Nova IT."
    orgLine="Demo och innehåll är fiktivt."
    senderLine="Webbportfolio – ett projekt från Nova IT"
    columns={[
      {
        heading: "Cafédemo",
        links: [
          { label: "Menyn", href: "/demo/cafe/#meny" },
          { label: "Öppettider", href: "/demo/cafe/#oppettider" },
          { label: "Evenemang", href: "/demo/cafe/#evenemang" },
        ],
      },
      {
        heading: "Webbportfolio",
        links: [
          { label: "Tillbaka till Webbportfolio", href: "/" },
          { label: "Se alla webbplatser", href: "/webbplatser/" },
        ],
      },
    ]}
  />
</BaseLayout>
