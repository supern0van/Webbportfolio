---
// Mall B — väljare → rekommendation. Används av briefer vars egen "Primär
// funktion" är en enval-väljare som ger en motiverad rekommendation
// (tandvård, bilvård, utbildning). Samma aria-pressed/enval-mönster som
// DemoDock, återgivet med de ljusa .chip-klasserna.
import WebbportfolioLayout from "../../layouts/WebbportfolioLayout.astro";
import type { BriefDemo } from "../../data/briefDemos";

interface Props {
  demo: BriefDemo;
}

const { demo } = Astro.props;
---

<WebbportfolioLayout
  title={`${demo.branch} — ${demo.name}`}
  description={`${demo.headline} Genomarbetad brief, ännu inte byggd som interaktiv demo.`}
>
  <section class="section" style="border-bottom: 1px solid var(--border);">
    <div class="container" style="max-width: 42rem;">
      <p class="eyebrow">{demo.branch} · {demo.name}</p>
      <span class="badge" style="margin-bottom: 1rem;">Brief – ännu inte byggd som interaktiv demo</span>
      <h1 style="font-size: clamp(2rem, 4.5vw, 2.9rem); margin-top: 0.75rem;">{demo.headline}</h1>
      <p class="lede" style="margin-top: 1rem;">{demo.subheadline}</p>
      <p style="margin-top: 1.75rem;">
        <a class="btn btn-secondary" href="/webbplatser/">← Tillbaka till alla webbplatser</a>
      </p>
    </div>
  </section>

  <section class="section section--tight" style="border-bottom: 1px solid var(--border); background: var(--bg-alt);">
    <div class="container" style="max-width: 34rem;">
      <p class="eyebrow">{demo.recommendPrompt}</p>
      <div class="dock-options" style="margin-top: 0.75rem;">
        {
          demo.recommendOptions?.map((opt) => (
            <button type="button" class="chip" aria-pressed="false" data-recommend-option data-reveal={`opt-${opt.id}`}>
              {opt.label}
            </button>
          ))
        }
        <button type="button" class="chip-reset" data-recommend-reset>Återställ</button>
      </div>

      {
        demo.recommendOptions?.map((opt) => (
          <div id={`opt-${opt.id}`} class="chip-detail" data-recommend-detail hidden>
            <strong>{opt.resultTitle}</strong>
            {opt.resultText}
          </div>
        ))
      }
      <p class="chip-notice">Demo — ingen bedömning görs och ingen uppgift skickas eller sparas.</p>
    </div>
  </section>

  <section class="section section--tight" style="border-bottom: 1px solid var(--border);">
    <div class="container">
      <div style="display: flex; gap: 0.6rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
        {
          demo.palette.map((color) => (
            <span
              style={`display:inline-block; width:2.25rem; height:2.25rem; border-radius: 999px; background:${color}; border: 1px solid var(--border);`}
              title={color}
            />
          ))
        }
      </div>
      <div class="grid grid-2">
        <div>
          <h2 style="font-size: 0.95rem; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.06em;">Ton</h2>
          <p style="margin-top: 0.4rem;">{demo.tone}</p>
        </div>
        <div>
          <h2 style="font-size: 0.95rem; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.06em;">Bildspråk</h2>
          <p style="margin-top: 0.4rem;">{demo.imagery}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" style="border-bottom: 1px solid var(--border);">
    <div class="container grid grid-2" style="align-items: start;">
      <div>
        <p class="eyebrow">Struktur i briefen</p>
        <ul style="margin-top: 1rem; display: grid; gap: 0.6rem;">
          {demo.structure.map((item) => <li style="color: var(--fg-muted);">{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Interaktiva idéer</p>
        <ul style="margin-top: 1rem; display: grid; gap: 0.6rem;">
          {demo.interactiveIdeas.map((item) => <li style="color: var(--fg-muted);">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight" style="border-bottom: 1px solid var(--border); background: var(--bg-alt);">
    <div class="container grid grid-2">
      <div class="card" style="background: var(--card);">
        <h2 style="font-size: 1.02rem;">Tänkt primär funktion</h2>
        <p class="form-note" style="margin-top: 0.6rem;">{demo.primaryFunction}</p>
      </div>
      <div class="card" style="background: var(--card);">
        <h2 style="font-size: 1.02rem;">Ska skilja sig genom att</h2>
        <p class="form-note" style="margin-top: 0.6rem;">{demo.differentiator}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container" style="max-width: 38rem;">
      <p class="form-note">
        Det här är en förhandsvisning av ett genomarbetat underlag, inte en färdig interaktiv
        webbplats. Den fullständiga briefen ligger i
        {" "}<code>docs/webbportfolio-spec/hemsidor/</code>.
      </p>
      <p style="margin-top: 1.5rem;">
        <a class="btn btn-primary" href="/webbplatser/">Se hela biblioteket</a>
      </p>
    </div>
  </section>
</WebbportfolioLayout>

<script>
  const options = document.querySelectorAll<HTMLButtonElement>("[data-recommend-option]");
  const details = document.querySelectorAll<HTMLElement>("[data-recommend-detail]");
  const resetBtn = document.querySelector<HTMLButtonElement>("[data-recommend-reset]");

  function select(chosen: HTMLButtonElement | null) {
    options.forEach((opt) => opt.setAttribute("aria-pressed", String(opt === chosen)));
    details.forEach((detail) => {
      detail.hidden = detail.id !== chosen?.dataset.reveal;
    });
  }

  options.forEach((opt) => {
    opt.addEventListener("click", () => {
      const alreadyPressed = opt.getAttribute("aria-pressed") === "true";
      select(alreadyPressed ? null : opt);
    });
  });

  resetBtn?.addEventListener("click", () => select(null));
</script>
