---
interface Column {
  heading: string;
  links: { label: string; href: string }[];
}

interface Props {
  siteName: string;
  tagline: string;
  columns: Column[];
  orgLine: string;
}

const { siteName, tagline, columns, orgLine } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <h3>{siteName}</h3>
      <p>{tagline}</p>
    </div>
    {
      columns.map((column) => (
        <div>
          <h3>{column.heading}</h3>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container site-footer__bottom">
    <span>© {year} {siteName}. {orgLine}</span>
    <span>Exempelsajt byggd av Nova IT.</span>
  </div>
</footer>
