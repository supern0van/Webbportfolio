---
// A deliberate stand-in for a photo: this project uses no stock or invented
// "real" photography, so every image spot is an abstract, on-brand tile
// instead. Keeps demo content honestly demo-like.
interface Props {
  label: string;
  ratio?: string;
  variant?: "primary" | "accent" | "muted";
}

const { label, ratio = "4 / 3", variant = "muted" } = Astro.props;
---

<div class={`placeholder placeholder--${variant}`} style={`aspect-ratio: ${ratio};`}>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    border-radius: var(--radius);
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    border: 1px solid var(--border);
    background-color: color-mix(in oklab, var(--tone) 22%, var(--bg));
    background-image: repeating-linear-gradient(
      135deg,
      color-mix(in oklab, var(--tone) 16%, var(--bg)) 0,
      color-mix(in oklab, var(--tone) 16%, var(--bg)) 12%,
      transparent 12%,
      transparent 50%
    );
    /* Tile size scales with viewport width instead of staying pixel-fixed,
       so the diagonal texture reads as a deliberate pattern instead of
       noise on large hero-sized placeholders. */
    background-size: clamp(28px, 4vw, 80px) clamp(28px, 4vw, 80px);
  }

  .placeholder span {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-muted);
  }

  .placeholder--primary {
    --tone: var(--primary);
  }

  .placeholder--accent {
    --tone: var(--accent);
  }

  .placeholder--muted {
    --tone: var(--border);
  }
</style>
